<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal IPC-2581B document, hand-written for openPDN's importer tests.

  Deliberately tiny and readable: a two-layer board with a core, two nets and
  one component. It exercises the boundary pieces the importer has today:
  namespaced root element, declared revision, declared units, top-level section
  layout. It is the target the structural extraction in milestone 1 will be
  written against.

  Not generated by any CAD tool, so nothing confidential is committed and every
  value here is explainable. It is not a conformance sample and does not claim
  to exercise the full standard.
-->
<IPC-2581 revision="B" xmlns="http://webstds.ipc.org/2581">
  <Content roleRef="Owner">
    <FunctionMode mode="FABRICATION"/>
    <StepRef name="minimal-two-layer"/>
    <LayerRef name="TOP"/>
    <LayerRef name="CORE"/>
    <LayerRef name="BOTTOM"/>
    <DictionaryStandard units="MILLIMETER"/>
  </Content>

  <LogisticHeader>
    <Role id="Owner" roleFunction="OWNER"/>
    <Enterprise id="openPDN" code="OPENPDN"/>
  </LogisticHeader>

  <HistoryRecord number="1" origination="2026-08-14" software="openPDN test fixture"
                 lastChange="2026-08-14"/>

  <Ecad name="minimal-two-layer">
    <CadHeader units="MILLIMETER"/>
    <CadData>
      <Layer name="TOP" layerFunction="CONDUCTOR" side="TOP" polarity="POSITIVE"/>
      <Layer name="CORE" layerFunction="DIELCORE" side="INTERNAL" polarity="POSITIVE"/>
      <Layer name="BOTTOM" layerFunction="CONDUCTOR" side="BOTTOM" polarity="POSITIVE"/>

      <Stackup name="minimal-stackup" overallThickness="1.600" whereMeasured="LAMINATE">
        <StackupGroup name="primary" thickness="1.600">
          <StackupLayer layerOrGroupRef="TOP" thickness="0.0348" sequence="1"/>
          <StackupLayer layerOrGroupRef="CORE" thickness="1.5304" sequence="2"/>
          <StackupLayer layerOrGroupRef="BOTTOM" thickness="0.0348" sequence="3"/>
        </StackupGroup>
      </Stackup>

      <Step name="minimal-two-layer">
        <Profile>
          <Polygon>
            <PolyBegin x="0.0" y="0.0"/>
            <PolyStepSegment x="50.0" y="0.0"/>
            <PolyStepSegment x="50.0" y="30.0"/>
            <PolyStepSegment x="0.0" y="30.0"/>
            <PolyStepSegment x="0.0" y="0.0"/>
          </Polygon>
        </Profile>

        <Package name="SOT23" type="OTHER" pinOne="OTHER" pinOneOrientation="OTHER"/>

        <Component refDes="U1" packageRef="SOT23" layerRef="TOP" part="regulator">
          <Xform xOffset="10.0" yOffset="15.0" rotation="0.0"/>
        </Component>

        <LogicalNet name="VCC0V85">
          <PinRef componentRef="U1" pin="1"/>
        </LogicalNet>
        <LogicalNet name="GND">
          <PinRef componentRef="U1" pin="2"/>
        </LogicalNet>

        <LayerFeature layerRef="TOP">
          <Set net="VCC0V85">
            <Features>
              <Polyline>
                <PolyBegin x="5.0" y="9.0"/>
                <PolyStepSegment x="45.0" y="9.0"/>
                <LineDesc lineEnd="ROUND" lineWidth="0.5" lineProperty="SOLID"/>
              </Polyline>
            </Features>
          </Set>
        </LayerFeature>

        <LayerFeature layerRef="BOTTOM">
          <Set net="GND">
            <Features>
              <Polyline>
                <PolyBegin x="5.0" y="22.0"/>
                <PolyStepSegment x="45.0" y="22.0"/>
                <LineDesc lineEnd="ROUND" lineWidth="0.5" lineProperty="SOLID"/>
              </Polyline>
            </Features>
          </Set>
        </LayerFeature>
      </Step>
    </CadData>
  </Ecad>
</IPC-2581>
