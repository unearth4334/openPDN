# ---------------------------------------------------------------------------
# openPDN example environment file.
#
# Copy to `.env` (gitignored) and adjust. Every runtime setting is read in
# exactly one place: packages/infrastructure/src/openpdn/infrastructure/config.py
# Never call os.getenv() elsewhere in the codebase.
# ---------------------------------------------------------------------------

# Optional TOML configuration file, read below environment variables.
# OPENPDN_CONFIG_FILE=./openpdn.toml

# Deployment environment label: development | staging | production
OPENPDN_ENVIRONMENT=development

# Logging -------------------------------------------------------------------
# Level: DEBUG | INFO | WARNING | ERROR
OPENPDN_LOG_LEVEL=INFO
# Format: json (machine ingestion) | text (human console)
OPENPDN_LOG_FORMAT=text

# Filesystem ----------------------------------------------------------------
# Persistent data (imported boards, studies). Container default: /var/lib/openpdn
OPENPDN_DATA_DIR=./.cache/data
# Derived, regenerable artefacts (meshes, matrices). Container default: /var/cache/openpdn
OPENPDN_CACHE_DIR=./.cache/cache

# Adapter selection ---------------------------------------------------------
# PCB importer: auto (detect from the document) | ipc2581 (implemented)
#             | canonical-json (implemented) | odbpp (planned)
# Leave on 'auto' unless you need to force one; openPDN identifies the format
# from the document itself rather than from its filename.
OPENPDN_IMPORTER=auto
# Electrical solver: mock (implemented) | padne | native-fem | elmer (planned)
OPENPDN_SOLVER=mock

# HTTP API ------------------------------------------------------------------
OPENPDN_API_HOST=127.0.0.1
OPENPDN_API_PORT=8000
# Directory holding the built frontend (apps/web/dist). Empty disables serving.
# OPENPDN_STATIC_DIR=
# Hard limit on uploaded PCB archives, bytes (untrusted input, see SECURITY.md).
OPENPDN_MAX_UPLOAD_BYTES=268435456

# Development conveniences ----------------------------------------------------
# Local PCB source the development UI offers to import with one click.
# Only honoured when OPENPDN_ENVIRONMENT=development; never set in production.
# OPENPDN_DEV_FIXTURE=./test.cvg
